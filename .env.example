# Copy to .env and fill in. Never commit .env.

# Google AI Studio key with access to the Live API
GEMINI_API_KEY=
# Optional: override the Live model (default gemini-3.8-live)
# GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional: send traces to Logfire (project settings -> Write tokens)
# LOGFIRE_TOKEN=
